@prefix lodacc: <https://w3id.org/lodacc> .
@prefix dct:   <http://www.w3.org/ns/dcat#> .
@prefix dqv:    <http://www.w3.org/ns/dqv#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# Metadata about the ontology
#################################################################

<https://w3id.org/lodacc> a owl:Ontology ;
    dct:title "LOD Accessibility Ontology (LODAcc)";
    dct:description "An ontology to describe accessibility-related parameters and metrics for Linked Open Data datasets.";
    dct:issued "2025-11-21"^^xsd:date ;
    dct:creator "Authors Names" ;
    dcat:contactPoint "Authors Emails" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:identifier "TBA" ;
    dct:language "en"^^xsd:language ;
    owl:versionInfo "0.1" .

#################################################################
# Core classes
#################################################################

lodacc:AccessibilityCategory a rdfs:Class ;
    rdfs:label "Accessibility Category" ;
    rdfs:comment "A high-level accessibility category grouping related dimensions." ;
    rdfs:subClassOf dqv:Category .

lodacc:AccessibilityDimension a rdfs:Class ;
    rdfs:label "Accessibility Dimension" ;
    rdfs:comment "A specific aspect of accessibility that can be evaluated (e.g. licensing)." ;
    rdfs:subClassOf dqv:Dimension .

lodacc:AccessibilityMetric a rdfs:Class ;
    rdfs:label "Accessibility Metric" ;
    rdfs:comment "A measurable metric used to assess a particular accessibility dimension." ;
    rdfs:subClassOf dqv:Metric .

#################################################################
# AccessibilityCategory Instances
#################################################################

lodacc:PerceivableCategory a lodacc:AccessibilityCategory ;
    rdfs:label "Perceivable Category" .

lodacc:OperableCategory a lodacc:AccessibilityCategory ;
    rdfs:label "Operable Category" .

lodacc:UnderstandableCategory a lodacc:AccessibilityCategory ;
    rdfs:label "Understandable Category" .

lodacc:RobustCategory a lodacc:AccessibilityCategory ;
    rdfs:label "Robust Category" .

lodacc:SpecialNeedsCategory a lodacc:AccessibilityCategory ;
    rdfs:label "Special Needs Category" ;
    rdfs:comment "Accessibility category for dimensions specifically supporting users with special needs (e.g., alt text, audio descriptions, captions, sign language, transcripts)." .


#################################################################
# WCAG principles as SKOS concepts
#################################################################

lodacc:WCAGPrinciple a skos:ConceptScheme ;
    rdfs:label "WCAG Accessibility Principles" ;
    rdfs:comment "Concept scheme for the four WCAG accessibility principles." .

lodacc:Perceivable a skos:Concept ;
    skos:inScheme lodacc:WCAGPrinciple ;
    skos:prefLabel "Perceivable" ;
    rdfs:comment "Information and user interface components must be presentable to users in ways they can perceive." .

lodacc:Operable a skos:Concept ;
    skos:inScheme lodacc:WCAGPrinciple ;
    skos:prefLabel "Operable" ;
    rdfs:comment "User interface components and navigation must be operable." .

lodacc:Understandable a skos:Concept ;
    skos:inScheme lodacc:WCAGPrinciple ;
    skos:prefLabel "Understandable" ;
    rdfs:comment "Information and the operation of the user interface must be understandable." .

lodacc:Robust a skos:Concept ;
    skos:inScheme lodacc:WCAGPrinciple ;
    skos:prefLabel "Robust" ;
    rdfs:comment "Content must be robust enough that it can be interpreted by a wide variety of user agents, including assistive technologies." .

#################################################################
# Relations
#################################################################

### Category → WCAG Principle Concept
lodacc:alignedToPrinciple a rdf:Property ;
    rdfs:label "aligned to WCAG principle" ;
    rdfs:comment "Links an accessibility category to the WCAG principle(s) it primarily addresses." ;
    rdfs:domain lodacc:AccessibilityCategory ;
    rdfs:range  skos:Concept .

### Dimension → Category
# (using dqv:inCategory)
dqv:inCategory a rdf:Property ;
    rdfs:label "in category" ;
    rdfs:comment "Associates an accessibility dimension with an accessibility category." ;
    rdfs:domain lodacc:AccessibilityDimension ;
    rdfs:range  lodacc:AccessibilityCategory .

### Metric → Dimension
# (using dqv:inDimension)
dqv:inDimension a rdf:Property ;
    rdfs:label "in dimension" ;
    rdfs:comment "Associates an accessibility metric with the dimension it measures." ;
    rdfs:domain lodacc:AccessibilityMetric ;
    rdfs:range  lodacc:AccessibilityDimension .

### Dimension → Dimension (requirements/dependencies)
lodacc:hasRequerement a rdf:Property ;
    rdfs:label "has requirement" ;
    rdfs:comment "Indicates that one accessibility dimension requires or depends on another dimension." ;
    rdfs:domain lodacc:AccessibilityDimension ;
    rdfs:range  lodacc:AccessibilityDimension .

#################################################################
# Relationships Instances
#################################################################

lodacc:PerceivableCategory lodacc:alignedToPrinciple lodacc:Perceivable .

lodacc:UnderstandableCategory lodacc:alignedToPrinciple lodacc:Understandable .

lodacc:OperableCategory lodacc:alignedToPrinciple lodacc:Operable .

lodacc:RobustCategory lodacc:alignedToPrinciple lodacc:Robust .
#################################################################
# Data properties
#################################################################

lodacc:dimensionLevel a owl:DatatypeProperty ;
    rdfs:label "Dimension Level" ;
    rdfs:comment "Indicates whether the accessibility dimension applies to the data level or metadata level." ;
    rdfs:domain lodacc:AccessibilityDimension ;
    rdfs:range xsd:string .

lodacc:scoringFunction a owl:DatatypeProperty ;
    rdfs:label "scoring function" ;
    rdfs:comment "Description of how this accessibility metric is computed." ;
    rdfs:domain lodacc:AccessibilityMetric ;
    rdfs:range  xsd:string .

#################################################################
# DIMENSIONS
#################################################################
#################################################################
# Perceivable – Dimensions
#################################################################

lodacc:ImageMetadataDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Image metadata" ;
    rdfs:comment "Presence of metadata representations as an image (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:ImageDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Image" ;
    rdfs:comment "Visual element enriching a dataset’s expressiveness, accessibility, and multimodal value (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "data" .

lodacc:AudioMetadataDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Audio metadata" ;
    rdfs:comment "Presence of metadata representations as an audio resource (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:AudioDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Audio" ;
    rdfs:comment "Audio element enriching a dataset’s expressiveness, accessibility, and multimodal value (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "data" .

lodacc:VideoMetadataDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Video metadata" ;
    rdfs:comment "Presence of metadata representations as a video (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:VideoDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Video" ;
    rdfs:comment "Video element enriching a dataset’s expressiveness, accessibility, and multimodal value (cf. WCAG text alternatives guidance)." ;
    dqv:inCategory lodacc:PerceivableCategory ;
    lodacc:dimensionLevel "data" .

#################################################################
# Understandable – Dimensions
#################################################################

lodacc:MetadataLanguageDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Metadata language" ;
    rdfs:comment "Metadata tags specify language for human-readable fields (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:UnderstandableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:DataLanguageDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Data language" ;
    rdfs:comment "Data triples specify language for literal values (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:UnderstandableCategory ;
    lodacc:dimensionLevel "data" .

lodacc:LabelsDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Labels" ;
    rdfs:comment "Ratio of resources with human-readable labels (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:UnderstandableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:SPARQLExamplesDimension a lodacc:AccessibilityDimension ;
    rdfs:label "SPARQL Examples" ;
    rdfs:comment "Examples of SPARQL queries or similar usage examples are provided (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:UnderstandableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:DescriptionReadabilityDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Description readability" ;
    rdfs:comment "Degree to which the dataset description uses clear, plain language to ensure broad accessibility and comprehension. Computed via Flesh Reading Easy score." ;
    dqv:inCategory lodacc:UnderstandableCategory ;
    lodacc:dimensionLevel "metadata" .

#################################################################
# Operable – Dimensions
#################################################################

lodacc:ContactPersonDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Contact person" ;
    rdfs:comment "Maintainer or responsible party is explicitly reported (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:DumpSizeDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Dump size" ;
    rdfs:comment "Dump is available in a compressed, validated format suitable for download (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "data" .

lodacc:AuthenticationDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Authentication" ;
    rdfs:comment "Endpoint or API access requires credentials, which may discourage or limit access (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:DumpFormatDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Dump format" ;
    rdfs:comment "Dataset dump uses a valid RDF serialization (e.g., Turtle, JSON-LD, RDF/XML) (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "data" .

lodacc:OpenLicenseDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Open license" ;
    rdfs:comment "Use of an open license, expressed as a URL, to ensure free reuse and redistribution (cf. Zaveri et al. 2016 and Open Source Definition)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:AlternativeAccessPointsDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Alternative access points" ;
    rdfs:comment "Dataset is accessible via multiple access points (e.g., SPARQL endpoint, dump, API) (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:OperableCategory ;
    lodacc:dimensionLevel "metadata" .

#################################################################
# Robust – Dimensions
#################################################################

lodacc:VersioningDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Versioning" ;
    rdfs:comment "Explicit dataset versioning is provided to track changes over time (cf. Käfer et al. 2013)." ;
    dqv:inCategory lodacc:RobustCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:RobotsTxtDimension a lodacc:AccessibilityDimension ;
    rdfs:label "robots.txt" ;
    rdfs:comment "Presence of a robots.txt reference in metadata, indicating crawling policies for automated agents." ;
    dqv:inCategory lodacc:RobustCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:WebpageBrokenLinkDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Webpage broken link" ;
    rdfs:comment "Guarantees that the dataset’s main webpage is provided and accessible (i.e., not a broken link) (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:RobustCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:BrokenMetadataLinkRateDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Broken metadata link rate" ;
    rdfs:comment "Proportion of dataset metadata links that fail to resolve (cf. Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:RobustCategory ;
    lodacc:dimensionLevel "metadata" .

lodacc:CanonicalIDDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Canonical identifier" ;
    rdfs:comment "Unique persistent identifier (e.g., DOI) provided for the dataset (cf. FAIR principles and Zaveri et al. 2016)." ;
    dqv:inCategory lodacc:RobustCategory ;
    lodacc:dimensionLevel "metadata" .

#################################################################
# Special Needs – Dimensions
#################################################################

lodacc:AltDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Alt text" ;
    rdfs:comment "Ratio of images with descriptive alternative text." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:AudioDescriptionDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Audio description" ;
    rdfs:comment "Presence of entities with audio description to support non-visual access." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:VideoDescriptionDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Video description" ;
    rdfs:comment "Presence of entities with audio description or descriptive narration for video content." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:SignLanguageVideoDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Sign language video" ;
    rdfs:comment "Presence of sign language in video content." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:SignLanguageAudioDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Sign language audio" ;
    rdfs:comment "Presence of sign language content in audio or audio-linked resources." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:CaptionsVideoDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Video captions" ;
    rdfs:comment "Ratio of videos with synchronized captions." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:CaptionsAudioDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Audio captions" ;
    rdfs:comment "Ratio of audio resources with synchronized captions." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:TranscriptVideoDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Video transcripts" ;
    rdfs:comment "Ratio of videos with an associated text transcript." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .

lodacc:TranscriptAudioDimension a lodacc:AccessibilityDimension ;
    rdfs:label "Audio transcripts" ;
    rdfs:comment "Ratio of audio resources with an associated text transcript." ;
    dqv:inCategory lodacc:SpecialNeedsCategory ;
    lodacc:dimensionLevel "data" .


###### Requirements ######
lodacc:AltDimension lodacc:hasRequerement lodacc:ImageDimension .
lodacc:AudioDescriptionDimension lodacc:hasRequerement lodacc:AudioDimension .
lodacc:VideoDescriptionDimension lodacc:hasRequerement lodacc:VideoDimension .
lodacc:SignLanguageVideoDimension lodacc:hasRequerement lodacc:VideoDimension .
lodacc:SignLanguageAudioDimension lodacc:hasRequerement lodacc:AudioDimension .
lodacc:CaptionsVideoDimension lodacc:hasRequerement lodacc:VideoDimension .
lodacc:CaptionsAudioDimension lodacc:hasRequerement lodacc:AudioDimension .
lodacc:TranscriptVideoDimension lodacc:hasRequerement lodacc:VideoDimension .
lodacc:TranscriptAudioDimension lodacc:hasRequerement lodacc:AudioDimension .

#################################################################
# METRICS
#################################################################
#################################################################
# Perceivable – Metrics
#################################################################

lodacc:ImageMetadataMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Image metadata metric" ;
    dqv:inDimension lodacc:ImageMetadataDimension ;
    lodacc:scoringFunction "1 if at least one metadata representation is provided as an image, 0 otherwise." .

lodacc:ImageMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Image metric" ;
    dqv:inDimension lodacc:ImageDimension ;
    lodacc:scoringFunction "# resources with image src / # resources." .

lodacc:AudioMetadataMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Audio metadata metric" ;
    dqv:inDimension lodacc:AudioMetadataDimension ;
    lodacc:scoringFunction "1 if at least one audio metadata representation is present, 0 otherwise." .

lodacc:AudioMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Audio metric" ;
    dqv:inDimension lodacc:AudioDimension ;
    lodacc:scoringFunction "# resources with audio src / # resources." .

lodacc:VideoMetadataMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Video metadata metric" ;
    dqv:inDimension lodacc:VideoMetadataDimension ;
    lodacc:scoringFunction "1 if at least one video metadata representation is present, 0 otherwise." .

lodacc:VideoMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Video metric" ;
    dqv:inDimension lodacc:VideoDimension ;
    lodacc:scoringFunction "# resources with video src / # resources." .

#################################################################
# Understandable – Metrics
#################################################################

lodacc:MetadataLanguageMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Metadata language metric" ;
    dqv:inDimension lodacc:MetadataLanguageDimension ;
    lodacc:scoringFunction "-1 + ( # metadata tags with lang tag / # metadata tags )." .

lodacc:DataLanguageMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Data language metric" ;
    dqv:inDimension lodacc:DataLanguageDimension ;
    lodacc:scoringFunction "- ( # triples with a string object and lang tag / # triples with a string as object )." .

lodacc:LabelsMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Labels metric" ;
    dqv:inDimension lodacc:LabelsDimension ;
    lodacc:scoringFunction "-1 + ( # resources with rdfs:label / # resources )." .

lodacc:ExamplesMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Examples metric" ;
    dqv:inDimension lodacc:ExamplesDimension ;
    lodacc:scoringFunction "1 if at least one SPARQL query (or usage) example is provided, 0 otherwise." .

lodacc:DescriptionReadabilityMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Description readability metric" ;
    dqv:inDimension lodacc:DescriptionReadabilityDimension ;
    lodacc:scoringFunction "If Flesch Reading Ease score > 100 then 1, else if Flesch Reading Ease score <-1 then -1,  else (Flesch score / 50) - 1." .

#################################################################
# Operable – Metrics
#################################################################

lodacc:ContactPersonMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Contact person metric" ;
    dqv:inDimension lodacc:ContactPersonDimension ;
    lodacc:scoringFunction "1 if a contact person or organization is explicitly reported, 0 otherwise." .

lodacc:DumpSizeMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Dump size metric" ;
    dqv:inDimension lodacc:DumpSizeDimension ;
    lodacc:scoringFunction "1 if data dump size < 500MB; 0 if size in [500MB, 4GB]; -1 if size > 4GB." .

lodacc:AuthenticationMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Authentication metric" ;
    dqv:inDimension lodacc:AuthenticationDimension ;
    lodacc:scoringFunction "0 if SPARQL endpoint is freely accessible; -1 otherwise." .

lodacc:DumpFormatMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Dump format metric" ;
    dqv:inDimension lodacc:DumpFormatDimension ;
    lodacc:scoringFunction "0 if dump is available in a valid RDF serialization (e.g., Turtle, JSON-LD, RDF/XML); -1 otherwise." .

lodacc:OpenLicenseMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Open license metric" ;
    dqv:inDimension lodacc:OpenLicenseDimension ;
    lodacc:scoringFunction "1 for an open license; 0 if license is missing; -1 for a non-open license." .

lodacc:AlternativeAccessPointsMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Alternative access points metric" ;
    dqv:inDimension lodacc:AlternativeAccessPointsDimension ;
    lodacc:scoringFunction "1 if there are two or more access points (e.g., SPARQL endpoint, dump, API); 0 otherwise." .

#################################################################
# Robust – Metrics
#################################################################

lodacc:VersioningMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Versioning metric" ;
    dqv:inDimension lodacc:VersioningDimension ;
    lodacc:scoringFunction "0 if standard dataset versioning is provided; -1 otherwise." .

lodacc:RobotsTxtMetric a lodacc:AccessibilityMetric ;
    rdfs:label "robots.txt metric" ;
    dqv:inDimension lodacc:RobotsTxtDimension ;
    lodacc:scoringFunction "1 if a robots.txt reference is present; 0 otherwise." .

lodacc:WebpageBrokenLinkMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Webpage broken link metric" ;
    dqv:inDimension lodacc:WebpageBrokenLinkDimension ;
    lodacc:scoringFunction "0 if the dataset webpage URL returns an HTTP status code in [200, 399]; -1 otherwise." .

lodacc:BrokenMetadataLinkRateMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Broken metadata link rate metric" ;
    dqv:inDimension lodacc:BrokenMetadataLinkRateDimension ;
    lodacc:scoringFunction "- ( # broken metadata links / # metadata links )." .

lodacc:CanonicalIDMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Canonical identifier metric" ;
    dqv:inDimension lodacc:CanonicalIDDimension ;
    lodacc:scoringFunction "1 if a unique persistent identifier (e.g., DOI) is provided; 0 otherwise." .


#################################################################
# Special Needs – Metrics
#################################################################

lodacc:AltMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Alt text metric" ;
    rdfs:comment "Metric computing the ratio of images with descriptive alt-text." ;
    dqv:inDimension lodacc:AltDimension ;
    lodacc:scoringFunction "-1 + (# images with alt-text / # images)" .

lodacc:AudioDescriptionMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Audio description metric" ;
    rdfs:comment "Metric computing the ratio of entities with audio description." ;
    dqv:inDimension lodacc:AudioDescriptionDimension ;
    lodacc:scoringFunction "-1 + (# entities with audio description / # entities)" .

lodacc:VideoDescriptionMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Video description metric" ;
    rdfs:comment "Binary metric indicating whether at least one video with description exists." ;
    dqv:inDimension lodacc:VideoDescriptionDimension ;
    lodacc:scoringFunction "0 if at least one described video description exists; -1 otherwise." .

lodacc:SignLanguageVideoMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Sign language video metric" ;
    rdfs:comment "Metric computing the ratio of videos that include sign language interpretation." ;
    dqv:inDimension lodacc:SignLanguageVideoDimension ;
    lodacc:scoringFunction "-1 + (# videos with sign language interpretation / # videos)" .

lodacc:SignLanguageAudioMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Sign language audio metric" ;
    rdfs:comment "Metric computing the ratio of audio resources that include sign language interpretation (e.g., linked video or visual component)." ;
    dqv:inDimension lodacc:SignLanguageAudioDimension ;
    lodacc:scoringFunction "# -1 + (audio resources with sign language interpretation / # audio resources)" .

lodacc:CaptionsVideoMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Video captions metric" ;
    rdfs:comment "Metric computing the ratio of videos with synchronized captions." ;
    dqv:inDimension lodacc:CaptionsVideoDimension ;
    lodacc:scoringFunction "-1 + (# videos with captions / # videos)" .

lodacc:CaptionsAudioMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Audio captions metric" ;
    rdfs:comment "Metric computing the ratio of audio resources with synchronized captions." ;
    dqv:inDimension lodacc:CaptionsAudioDimension ;
    lodacc:scoringFunction "-1 + (# audio resources with captions / # audio resources)" .

lodacc:TranscriptVideoMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Video transcript metric" ;
    rdfs:comment "Metric computing the ratio of videos with an associated text transcript." ;
    dqv:inDimension lodacc:TranscriptVideoDimension ;
    lodacc:scoringFunction "-1 + (# videos with transcript / # videos)" .

lodacc:TranscriptAudioMetric a lodacc:AccessibilityMetric ;
    rdfs:label "Audio transcript metric" ;
    rdfs:comment "Metric computing the ratio of audio resources with an associated text transcript." ;
    dqv:inDimension lodacc:TranscriptAudioDimension ;
    lodacc:scoringFunction "-1 + (# audio resources with transcript / # audio resources)" .
